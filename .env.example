# Toca Estoque — variáveis de ambiente (configurar no Railway > Variables)
# Copie para .env em desenvolvimento local. NUNCA commitar o .env real.

# --- Obrigatórias ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=chave-service-role-do-supabase
ANTHROPIC_API_KEY=sk-ant-...

# Secret dos webhooks (bot WhatsApp / n8n). Sem ela os webhooks respondem 503.
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_SECRET=

# --- Seed de usuários (usadas SÓ no primeiro boot, quando a tabela users está vazia) ---
# Se não definidas, o sistema gera senhas aleatórias e imprime no log do Railway.
ADMIN_PASSWORD=
SEED_PASSWORD_NAYARA=
SEED_PASSWORD_SIMONE=
SEED_PASSWORD_ESTOQUE=

# --- Opcionais ---
# Origem permitida para CORS (URL do app). Se vazio, aceita qualquer origem.
ALLOWED_ORIGIN=
# Porta do servidor (Railway define automaticamente)
PORT=3000
# Hora do backup automático diário (0-23, horário de SP)
HORA_BACKUP=
